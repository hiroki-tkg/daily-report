{
  "name": "Domuz Design System",
  "version": "1.1.0",
  "updated": "2026-09-16",
  "notes": "Values measured from the 2025-07 company profile and the 2026-08 LY / Gipt / giftee proposals. Keep in sync with DESIGN_SYSTEM.md.",

  "color": {
    "green-900": "002B2F",
    "green-800": "004347",
    "green-500": "598487",
    "green-200": "A5BCBE",
    "green-100": "DFE7E7",
    "mint": "00D79C",

    "paper": "FFFFFF",
    "beige-100": "F9F6EF",
    "beige-200": "F5F2E8",
    "sand-300": "EDE7DC",
    "taupe-400": "D9D2C7",
    "mocha-700": "6B5E52",
    "gray-100": "F1F1F1",
    "gray-200": "E3E6E6",
    "gray-500": "929292",
    "ink-700": "404040",
    "ink-900": "1A1A1A",
    "watermark": "F7F7F7",

    "coral": "E16464",
    "coral-deep": "C94F4F",
    "hanaichi-yellow": "F8BA00",
    "highlight": "FFF59A"
  },

  "semantic": {
    "background": "paper",
    "background-section": "green-900",
    "card-warm": "beige-100",
    "card-warm-deep": "beige-200",
    "card-cool": "gray-100",
    "card-emphasis": "green-900",
    "heading": "green-800",
    "eyebrow": "green-500",
    "body": "ink-700",
    "number": "ink-900",
    "number-emphasis": "coral",
    "caption": "gray-500",
    "rule": "gray-200",
    "rule-on-warm": "taupe-400",
    "table-header": "green-100",
    "table-header-sales": "highlight",
    "badge": "green-800",
    "badge-text": "paper",
    "chart-series": ["green-800", "hanaichi-yellow", "green-500", "sand-300"],
    "accent-once": "mint"
  },

  "font": {
    "latin": "Century Gothic",
    "latin-display": "Europa",
    "latin-fallbacks": ["Futura", "Jost", "Poppins", "URW Gothic"],
    "japanese": "Hiragino Sans",
    "japanese-fallbacks": ["Noto Sans JP", "Noto Sans CJK JP"],
    "forbidden": ["Yu Gothic", "游ゴシック", "YuGothic", "MS Gothic", "MS PGothic", "Meiryo", "Aptos"]
  },

  "type": {
    "cover-title-ja":   { "size": 36, "bold": true,  "spacing": 2,  "color": "green-800" },
    "cover-title-en":   { "size": 44, "bold": true,  "spacing": 7,  "color": "green-800", "uppercase": true },
    "section-en":       { "size": 40, "bold": true,  "spacing": 10, "color": "paper",     "uppercase": true },
    "section-ja":       { "size": 9,  "bold": false, "spacing": 3,  "color": "green-200" },
    "title-ja":         { "size": 26, "bold": true,  "spacing": 2,  "color": "green-800" },
    "eyebrow":          { "size": 9.5,"bold": false, "spacing": 3.5,"color": "green-500", "uppercase": true },
    "subtitle-en":      { "size": 8.5,"bold": false, "spacing": 3.5,"color": "green-500", "uppercase": true },
    "heading-ja":       { "size": 14, "bold": true,  "spacing": 1,  "color": "green-800" },
    "body":             { "size": 11, "bold": false, "spacing": 0,  "color": "ink-700", "lineSpacingMultiple": 1.6 },
    "body-small":       { "size": 10, "bold": false, "spacing": 0,  "color": "ink-700", "lineSpacingMultiple": 1.5 },
    "kpi":              { "size": 40, "bold": true,  "spacing": 0,  "color": "coral" },
    "kpi-unit":         { "size": 11, "bold": false, "spacing": 1,  "color": "gray-500" },
    "label":            { "size": 9,  "bold": false, "spacing": 1,  "color": "gray-500" },
    "caption":          { "size": 8.5,"bold": false, "spacing": 2,  "color": "gray-500" },
    "badge":            { "size": 9,  "bold": true,  "spacing": 1,  "color": "paper" },
    "chrome":           { "size": 7.5,"bold": false, "spacing": 2,  "color": "gray-500" }
  },

  "layout": {
    "default": "standard",
    "standard": { "width": 10, "height": 7.5 },
    "wide":     { "width": 13.333, "height": 7.5 },
    "margin": 0.55,
    "header-y": 0.30,
    "footer-y": 7.10,
    "title-top": 0.62,
    "content-top": 1.65,
    "content-bottom": 6.85,
    "gutter": 0.25,
    "card-padding": 0.25,
    "min-gap": 0.20
  },

  "radius": {
    "card": 10,
    "photo": 8,
    "badge": 4,
    "note": 8,
    "diagram-box": 6
  },

  "stroke": {
    "rule": 0.5,
    "note-border": 1,
    "emphasis-frame": 1.5
  },

  "text": {
    "company-ja": "株式会社Domuz",
    "company-en": "Domuz inc.",
    "confidential": "Confidential",
    "copyright": "Copyright (C) Domuz inc, All Rights Reserved.",
    "eyebrow-format": "- {LABEL} -",
    "brands": { "andplants": "AND PLANTS", "andflower": "AND FLOWER", "hanaichi": "ハナイチ" }
  },

  "audience": {
    "sales":     { "cover": "minimal",   "card": "card-warm", "emphasis": "coral",           "header": true,  "table-header": "table-header-sales" },
    "financial": { "cover": "watermark", "card": "card-cool", "emphasis": "green-800",       "header": true,  "table-header": "table-header" },
    "internal":  { "cover": "watermark", "card": "card-warm", "emphasis": "hanaichi-yellow", "header": false, "table-header": "table-header" }
  }
}
